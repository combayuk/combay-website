# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── MOCK AUTH (pre-launch, no DB needed) ─────────────────────────────────────
MOCK_AUTH_ENABLED=true
MOCK_AUTH_EMAIL=test@combay.co.uk
MOCK_AUTH_PASSWORD=Test12345
ADMIN_EMAIL=admin@combay.co.uk
ADMIN_PASSWORD=combay-admin-2024

# ─── DATABASE (enable when going live) ────────────────────────────────────────
# DATABASE_URL="postgresql://combay:password@localhost:5432/combay_db"

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@combay.co.uk
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Combay <info@combay.co.uk>"

# ─── AI (admin product tools) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── STRIPE (checkout) ────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ─── SITE ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=447340383334
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-key-here
