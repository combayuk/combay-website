# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL="postgresql://combay:password@localhost:5432/combay_db"

# ─── AUTH ─────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── ADMIN ────────────────────────────────────────────
ADMIN_EMAIL="admin@combay.co.uk"
ADMIN_PASSWORD="change-this-immediately"

# ─── EMAIL (SMTP) ─────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="info@combay.co.uk"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Combay <info@combay.co.uk>"

# ─── SITE ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://combay.co.uk"
NEXT_PUBLIC_WHATSAPP="447340383334"

# ─── AI (optional - for admin product overview generation) ─
ANTHROPIC_API_KEY="sk-ant-..."

# ─── FILE STORAGE (optional - for product images) ────
# Using local filesystem by default; set these for S3-compatible storage
# STORAGE_PROVIDER="local"  # or "s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""  # for non-AWS S3-compatible (e.g. Cloudflare R2, MinIO)
