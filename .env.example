# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── MOCK AUTH (pre-launch only) ─────────────────────────────────────────────
# Production no longer enables mock auth by default. Set this explicitly while testing.
MOCK_AUTH_ENABLED=true
MOCK_CUSTOMER_EMAIL=test@combay.co.uk
MOCK_CUSTOMER_PASSWORD=Test12345
MOCK_ADMIN_EMAIL=admin@combay.co.uk
MOCK_ADMIN_PASSWORD=Admin12345
# Backwards compatibility only; prefer separate customer/admin variables above.
MOCK_AUTH_EMAIL=test@combay.co.uk
MOCK_AUTH_PASSWORD=Test12345

# ─── DATABASE (enable when going live) ────────────────────────────────────────
# DATABASE_URL="postgresql://combay:password@localhost:5432/combay_db"

# ─── REAL ADMIN BOOTSTRAP ─────────────────────────────────────────────────────
# Use once to create/promote the first database-backed admin account through
# POST /api/auth/bootstrap-admin with header x-bootstrap-token. Remove after use.
ADMIN_BOOTSTRAP_TOKEN=replace-with-long-random-token
ADMIN_LOGIN_EMAIL=admin@combay.co.uk
ADMIN_LOGIN_PASSWORD=replace-with-strong-admin-password


# ─── EMAIL (RESEND) ───────────────────────────────────────────────────────────
# Use a verified Resend domain for best deliverability.
RESEND_API_KEY=re_...
EMAIL_FROM="Combay <sales@combay.co.uk>"
EMAIL_REPLY_TO=sales@combay.co.uk
ADMIN_EMAIL=sales@combay.co.uk
# Optional. Defaults to NEXTAUTH_URL/images/combay-doc-logo.png
EMAIL_LOGO_URL=https://combay-website-lt8v.vercel.app/images/combay-doc-logo.png

# ─── AI (admin product tools) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── STRIPE (checkout) ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SITE ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=447340383334
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-key-here

# VPS upload receiver
UPLOAD_PROVIDER=vps
UPLOAD_BASE_URL=https://assets.combay.co.uk
UPLOAD_MAX_FILE_MB=50
UPLOAD_RECEIVER_URL=https://assets.combay.co.uk/_upload
UPLOAD_RECEIVER_SECRET=replace-with-long-random-secret

# eBay Inventory Sync (optional; can also be configured in Admin → eBay Sync)
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RUNAME=""
EBAY_ENVIRONMENT="production"
EBAY_MARKETPLACE_ID="EBAY_GB"

# eBay marketplace account deletion/closure notifications
# Endpoint to enter in eBay Developer: https://YOUR_SITE_DOMAIN/api/ebay/account-deletion
# Token must be 32-80 chars; only letters/numbers/underscore/hyphen.
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN="replace-with-32-to-80-char-token"
EBAY_ACCOUNT_DELETION_ENDPOINT_URL="https://combay-website-lt8v.vercel.app/api/ebay/account-deletion"

# AI product content assistant (server-side only; do not expose in NEXT_PUBLIC vars)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Scalable product image background processing — Phase 20A.3
# Vercel uses this secret to authenticate the VPS/local image worker.
IMAGE_WORKER_SECRET=
IMAGE_WORKER_AUTO_APPROVE_MIN_SCORE=85
IMAGE_WORKER_DEFAULT_MODEL=isnet-general-use
PRODUCT_IMAGE_BACKGROUND_URL=https://combay-website-lt8v.vercel.app/images/product-backgrounds/combay-background.jpg

# Direct remove.bg processing is intentionally off by default and should not be used for large catalogues.
EBAY_IMAGE_BACKGROUND_DIRECT_PROCESSING_ENABLED=false
REMOVE_BG_API_KEY=
