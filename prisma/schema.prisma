// Combay - Full Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ──────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  phone          String?
  company        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
  returns        Return[]
  supportTickets SupportTicket[]
  marketingPrefs MarketingPrefs?
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MarketingPrefs {
  id                  String   @id @default(cuid())
  userId              String   @unique
  newStockEmails      Boolean  @default(true)
  promotionEmails     Boolean  @default(true)
  categories          String[] // category slugs
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

// ─── PRODUCTS ──────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  brand            String?
  manufacturer     String?
  model            String?
  mpn              String?
  sku              String        @unique
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  condition        Condition     @default(USED)
  status           ProductStatus @default(DRAFT)
  price            Decimal?      @db.Decimal(10, 2)
  priceOnRequest   Boolean       @default(false)
  stockQty         Int           @default(1)
  description      String?       @db.Text
  productOverview  String?       @db.Text
  manufacturerUrl  String?
  weight           Decimal?      @db.Decimal(8, 3)
  dimensions       String?
  dispatchNote     String?
  leadTime         String?
  warranty         String?
  locationBin      String?
  hsCode           String?
  source           String?        @default("manual")
  ebayItemId       String?        @unique
  syncExcluded     Boolean       @default(false)

  // SEO
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?

  // Add-ons enabled
  addonSupport     Boolean       @default(false)
  addonWarranty    Boolean       @default(false)
  addonInstall     Boolean       @default(false)

  images           ProductImage[]
  faqs             ProductFaq[]
  documents        ProductDocument[]
  specs            ProductSpec[]
  orderItems       OrderItem[]
  tags             Tag[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  name      String
  url       String
  fileType  String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

enum Condition {
  NEW
  NEW_OPEN_BOX
  USED
  FOR_PARTS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── ORDERS ────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  company         String?
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @db.Decimal(10, 2) @default(0)
  tax             Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("GBP")
  notes           String?
  shippingAddress Json?
  trackingNumber  String?
  trackingCarrier String?
  trackingUrl     String?
  dispatchedAt    DateTime?
  items           OrderItem[]
  returns         Return[]
  invoices        Invoice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  title         String
  sku           String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  addonSupport  Boolean  @default(false)
  addonWarranty Boolean  @default(false)
  addonInstall  Boolean  @default(false)
  lineTotal     Decimal  @db.Decimal(10, 2)
}


model Invoice {
  id              String        @id @default(cuid())
  documentNumber  String        @unique
  type            InvoiceType
  status          InvoiceStatus @default(DRAFT)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  company         String?
  billingAddress  String?       @db.Text
  currency        String        @default("GBP")
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @db.Decimal(10, 2) @default(0)
  balanceDue      Decimal       @db.Decimal(10, 2) @default(0)
  paymentLink     String?
  bankDetails     String?       @db.Text
  shippingCountry String?
  shippingCost    Decimal       @db.Decimal(10, 2) @default(0)
  notes           String?       @db.Text
  paymentTerms    String?       @db.Text
  sentAt          DateTime?
  lines           InvoiceLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
}

enum InvoiceType {
  QUOTE
  PROFORMA_INVOICE
  COMMERCIAL_INVOICE
  ADDITIONAL_PAYMENT_REQUEST
  PAID_INVOICE
  PACKING_LIST
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  ACCEPTED
  PAID
  RECEIVED
  CANCELLED
  EXPIRED
  VOID
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  reason      String
  status      ReturnStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIAL
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  LABEL_SENT
  RECEIVED
  REFUNDED
  REJECTED
}

// ─── REQUESTS ──────────────────────────────────────────
model RepairRequest {
  id           String        @id @default(cuid())
  reference    String?       @unique
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  serviceType  String
  equipmentType String
  manufacturer String?
  model        String?
  faultDesc    String        @db.Text
  status       RequestStatus @default(NEW)
  assignedTo   String?
  notes        String?
  quotedPrice  Decimal?      @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AssetRecoveryRequest {
  id          String        @id @default(cuid())
  reference   String?       @unique
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  description String        @db.Text
  location    String?
  quantity    String?
  status      RequestStatus @default(NEW)
  notes       String?
  quotedValue Decimal?      @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContactRequest {
  id        String        @id @default(cuid())
  reference String?       @unique
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model QuoteRequest {
  id          String        @id @default(cuid())
  reference   String?       @unique
  name        String
  email       String
  phone       String?
  company     String?
  productUrl  String?
  productSku  String?
  productTitle String?
  source      String?
  description String        @db.Text
  quantity    Int           @default(1)
  status      RequestStatus @default(NEW)
  notes       String?
  createdAt   DateTime      @default(now())
}

model SupportTicket {
  id        String        @id @default(cuid())
  reference String?       @unique
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  name      String
  email     String
  orderId   String?
  phone     String?
  company   String?
  productSku String?
  productTitle String?
  source    String?
  subject   String
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}



model Lead {
  id           String   @id @default(cuid())
  name         String?
  email        String
  phone        String?
  country      String?
  company      String?
  source       String
  sourceRef    String?
  productSku   String?
  productTitle String?
  orderId      String?
  invoiceId    String?
  notes        String?   @db.Text
  contactCount Int      @default(1)
  lastContactAt DateTime @default(now())
  interactions LeadInteraction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([source])
  @@index([productSku])
  @@index([createdAt])
}

model LeadInteraction {
  id           String   @id @default(cuid())
  leadId       String
  source       String
  sourceRef    String?
  productSku   String?
  productTitle String?
  orderId      String?
  invoiceId    String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([source])
  @@index([createdAt])
}

// ─── CONTENT ───────────────────────────────────────────
model Promotion {
  id          String    @id @default(cuid())
  name        String
  code        String?   @unique
  type        PromotionType
  value       Decimal   @db.Decimal(8, 2)
  description String?
  isActive    Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
