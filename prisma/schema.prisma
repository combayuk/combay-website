// Combay - Full Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ──────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  phone          String?
  phoneCode      String?
  accountType    String?   @default("individual")
  company        String?
  companyEmail   String?
  designation    String?
  companyNumber  String?
  vatNumber      String?
  stripeCustomerId String? @unique
  twoStepEnabled Boolean  @default(false)
  twoStepMethod  String?
  requiresEmailVerification Boolean @default(false)
  suspendedAt    DateTime?
  suspendedReason String?
  suspendedEmailSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
  addresses      CustomerAddress[]
  returns        Return[]
  supportTickets SupportTicket[]
  marketingPrefs MarketingPrefs?
  accounts       Account[]
  sessions       Session[]

  @@index([suspendedAt])
  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MarketingPrefs {
  id                  String   @id @default(cuid())
  userId              String   @unique
  newStockEmails      Boolean  @default(true)
  promotionEmails     Boolean  @default(true)
  monthlyEmails       Boolean  @default(true)
  seasonalEmails      Boolean  @default(true)
  orderFollowupEmails Boolean  @default(true)
  allMarketingEmails  Boolean  @default(true)
  categories          String[] // category slugs
  unsubscribeToken    String   @unique @default(cuid())
  unsubscribedAt      DateTime?
  consentSource       String?
  consentUpdatedAt    DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unsubscribeToken])
  @@index([unsubscribedAt])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName    String?
  company     String?
  phone       String?
  address1    String
  address2    String?
  city        String
  postcode    String
  country     String   @default("United Kingdom")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([isPrimary])
}

enum Role {
  CUSTOMER
  ADMIN
}

// ─── PRODUCTS ──────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  brand            String?
  manufacturer     String?
  model            String?
  mpn              String?
  sku              String        @unique
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  condition        Condition     @default(USED)
  status           ProductStatus @default(DRAFT)
  price            Decimal?      @db.Decimal(10, 2)
  priceOnRequest   Boolean       @default(false)
  stockQty         Int           @default(1)
  description      String?       @db.Text
  productOverview  String?       @db.Text
  videoUrl         String?
  rawEbayDescription String?     @db.Text
  titleLocked      Boolean       @default(false)
  priceLocked      Boolean       @default(false)
  imagesLocked     Boolean       @default(false)
  specsLocked      Boolean       @default(false)
  descriptionLocked Boolean      @default(false)
  manufacturerUrl  String?
  weight           Decimal?      @db.Decimal(8, 3)
  dimensions       String?
  dispatchNote     String?
  leadTime         String?
  warranty         String?
  locationBin      String?
  itemLocation     String?        @default("United Kingdom")
  hsCode           String?
  source           String?        @default("manual")
  ebayItemId       String?        @unique
  syncExcluded     Boolean       @default(false)

  // eBay outbound publishing fields
  ebayListingId    String?
  ebayOfferId      String?
  ebayInventoryItemSku String?
  ebayMarketplaceId String?       @default("EBAY_GB")
  ebayCategoryId   String?
  ebayCategoryName String?
  ebayPublishStatus String?       @default("NOT_LISTED")
  ebayLastPushedAt DateTime?
  ebayLastPulledAt DateTime?
  ebayLastError    String?        @db.Text
  ebayExcludedFromSync Boolean    @default(false)
  ebaySourceOfTruth String?       @default("COMBAY")
  ebayConditionId  String?
  ebayConditionEnum String?
  ebayFulfillmentPolicyId String?
  ebayPaymentPolicyId String?
  ebayReturnPolicyId String?
  ebayInventoryLocationKey String?
  ebayDescriptionHtml String?     @db.Text
  ebayDescriptionTemplateId String?
  ebaySpecificsJson Json?
  ebayValidationErrorsJson Json?
  ebaySkuLocked    Boolean       @default(false)
  ebayShowOnUsCanada Boolean     @default(false)
  ebayBestOfferEnabled Boolean   @default(false)

  // deletion / lifecycle controls
  deletedAt        DateTime?
  deleteRequestedAt DateTime?
  deletePurgeAfter DateTime?
  deleteStatus     String?

  // Shipping policy assignment and product-specific shipping controls
  shippingPolicyId String?
  shippingPolicy   ShippingPolicy? @relation(fields: [shippingPolicyId], references: [id])
  packedWeightKg   Decimal?      @db.Decimal(8, 3)
  packedLengthCm   Decimal?      @db.Decimal(8, 2)
  packedWidthCm    Decimal?      @db.Decimal(8, 2)
  packedHeightCm   Decimal?      @db.Decimal(8, 2)
  shippingManualQuoteRequired Boolean @default(false)
  shippingCollectionOnly Boolean @default(false)
  shippingUkAllowed Boolean @default(true)
  shippingEuropeAllowed Boolean @default(true)
  shippingWorldwideAllowed Boolean @default(true)

  // SEO
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?

  // Add-ons enabled
  addonSupport     Boolean       @default(false)
  addonWarranty    Boolean       @default(false)
  addonInstall     Boolean       @default(false)

  images           ProductImage[]
  imageProcessingJobs ProductImageProcessingJob[]
  faqs             ProductFaq[]
  documents        ProductDocument[]
  specs            ProductSpec[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  promotionTargets PromotionProductTarget[]
  tags             Tag[]
  shippingOverrides ProductShippingOverride[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([sku])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([ebayListingId])
  @@index([ebayOfferId])
  @@index([ebayPublishStatus])
  @@index([ebayMarketplaceId])
  @@index([ebayCategoryId])
  @@index([ebayExcludedFromSync])
  @@index([ebayInventoryItemSku])
  @@index([deletedAt])
  @@index([deleteStatus])
}


model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  originalUrl String?
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  backgroundProcessedAt DateTime?
  backgroundProcessingStatus String?
  backgroundProcessingError String? @db.Text
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  processingJobs ProductImageProcessingJob[]

  @@index([backgroundProcessingStatus])
}

model ProductImageProcessingJob {
  id             String   @id @default(cuid())
  productId      String
  productImageId String
  sourceUrl      String   @db.Text
  status         String   @default("QUEUED")
  provider       String   @default("local-rembg")
  model          String?
  priority       Int      @default(0)
  attempts       Int      @default(0)
  workerId       String?
  resultUrl      String?  @db.Text
  previewUrl     String?  @db.Text
  qualityScore   Decimal? @db.Decimal(5, 2)
  qualityNotes   String?  @db.Text
  error          String?  @db.Text
  claimedAt      DateTime?
  processedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productImage ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([productId])
  @@index([productImageId])
}

model ProductImageBackupExport {
  id          String   @id @default(cuid())
  token       String   @unique
  status      String   @default("QUEUED")
  requestedBy String?
  email       String?
  imageCount  Int      @default(0)
  downloadUrl String?  @db.Text
  fileName    String?
  fileSize    Int?
  error       String?  @db.Text
  expiresAt   DateTime
  emailedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, expiresAt])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  name      String
  url       String
  fileType  String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}


model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String?
  label       String
  optionName  String?
  optionValue String?
  price       Decimal? @db.Decimal(10, 2)
  stockQty    Int      @default(0)
  sortOrder   Int      @default(0)
  ebayVariationSku String?
  ebayVariationData Json?
  ebaySku     String?
  ebayOfferId String?
  ebayInventoryItemGroupKey String?
  ebayQuantity Int?
  ebayPrice   Decimal? @db.Decimal(10, 2)
  ebaySpecificsJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([ebaySku])
  @@index([ebayOfferId])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

enum Condition {
  NEW
  NEW_OPEN_BOX
  USED
  FOR_PARTS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


// ─── SHIPPING POLICIES ────────────────────────────────
model ShippingPolicy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  internalNote String? @db.Text
  maxWeightKg Decimal? @db.Decimal(8, 3)
  maxLengthCm Decimal? @db.Decimal(8, 2)
  maxWidthCm  Decimal? @db.Decimal(8, 2)
  maxHeightCm Decimal? @db.Decimal(8, 2)
  packagingType String?
  manualQuoteRequired Boolean @default(false)
  collectionOnly Boolean @default(false)
  internationalAllowed Boolean @default(true)
  isDefault Boolean @default(false)
  isActive Boolean @default(true)
  adminOnlyNotes String? @db.Text

  // Future-ready eBay fulfilment mapping fields
  ebayFulfillmentPolicyId String?
  ebayMarketplaceId String? @default("EBAY_GB")
  ebayDomesticShippingServiceCode String?
  ebayInternationalShippingServiceCode String?
  ebayExcludedLocationsJson Json?
  ebayHandlingTimeDays Int?
  ebayCollectionOnly Boolean @default(false)
  ebayFreightRequired Boolean @default(false)
  ebayMappingStatus String? @default("UNMAPPED")

  rates ShippingPolicyRate[]
  products Product[]
  overrides ProductShippingOverride[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([ebayMarketplaceId])
}

model ShippingZone {
  id          String   @id @default(cuid())
  name        String   @unique
  countriesJson Json?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  rates       ShippingPolicyRate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ShippingPolicyRate {
  id               String   @id @default(cuid())
  shippingPolicyId String
  shippingZoneId   String
  shippingPolicy   ShippingPolicy @relation(fields: [shippingPolicyId], references: [id], onDelete: Cascade)
  zone             ShippingZone   @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  cost             Decimal? @db.Decimal(10, 2)
  currency         String   @default("GBP")
  dispatchMinDays  Int      @default(2)
  dispatchMaxDays  Int      @default(2)
  deliveryMinDays  Int?
  deliveryMaxDays  Int?
  manualQuoteRequired Boolean @default(false)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shippingPolicyId, shippingZoneId])
  @@index([shippingZoneId])
  @@index([isActive])
}

model ProductShippingOverride {
  id               String   @id @default(cuid())
  productId        String
  shippingPolicyId String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shippingPolicy   ShippingPolicy? @relation(fields: [shippingPolicyId], references: [id])
  zoneOverridesJson Json?
  packedWeightKg   Decimal? @db.Decimal(8, 3)
  packedLengthCm   Decimal? @db.Decimal(8, 2)
  packedWidthCm    Decimal? @db.Decimal(8, 2)
  packedHeightCm   Decimal? @db.Decimal(8, 2)
  manualQuoteRequired Boolean @default(false)
  collectionOnly Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([shippingPolicyId])
}

model OrderShippingSnapshot {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingPolicyName String?
  shippingZoneName   String?
  shippingCost       Decimal? @db.Decimal(10, 2)
  currency           String   @default("GBP")
  dispatchMinDays    Int?
  dispatchMaxDays    Int?
  deliveryMinDays    Int?
  deliveryMaxDays    Int?
  manualQuoteRequired Boolean @default(false)
  collectionOnly     Boolean @default(false)
  calculationMethod  String?
  detailsJson        Json?
  createdAt          DateTime @default(now())

  @@index([shippingZoneName])
  @@index([manualQuoteRequired])
}

// ─── ORDERS ────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  company         String?
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @db.Decimal(10, 2) @default(0)
  promotionCode   String?
  promotionName   String?
  shipping        Decimal     @db.Decimal(10, 2) @default(0)
  tax             Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("GBP")
  notes           String?
  shippingAddress Json?
  trackingNumber  String?
  trackingCarrier String?
  trackingUrl     String?
  dispatchedAt    DateTime?
  trackingEmailSentAt DateTime?
  trackingEmailLastHash String?
  salesChannel    String       @default("WEBSITE")
  externalOrderId String?
  externalMarketplace String?
  paidAt          DateTime?
  items           OrderItem[]
  returns         Return[]
  invoices        Invoice[]
  shippingSnapshot OrderShippingSnapshot?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([salesChannel])
  @@index([externalOrderId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  title         String
  sku           String
  variationSku  String?
  variationLabel String?
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  addonSupport  Boolean  @default(false)
  addonWarranty Boolean  @default(false)
  addonInstall  Boolean  @default(false)
  lineTotal     Decimal  @db.Decimal(10, 2)
}


model Invoice {
  id              String        @id @default(cuid())
  documentNumber  String        @unique
  type            InvoiceType
  status          InvoiceStatus @default(DRAFT)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  company         String?
  billingAddress  String?       @db.Text
  currency        String        @default("GBP")
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @db.Decimal(10, 2) @default(0)
  balanceDue      Decimal       @db.Decimal(10, 2) @default(0)
  paymentLink     String?
  bankDetails     String?       @db.Text
  shippingCountry String?
  shippingCost    Decimal       @db.Decimal(10, 2) @default(0)
  notes           String?       @db.Text
  paymentTerms    String?       @db.Text
  sentAt          DateTime?
  lines           InvoiceLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
}

enum InvoiceType {
  QUOTE
  PROFORMA_INVOICE
  COMMERCIAL_INVOICE
  ADDITIONAL_PAYMENT_REQUEST
  PAID_INVOICE
  PACKING_LIST
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  ACCEPTED
  PAID
  RECEIVED
  CANCELLED
  EXPIRED
  VOID
}

model Return {
  id                   String       @id @default(cuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id])
  userId               String?
  user                 User?        @relation(fields: [userId], references: [id])
  reason               String
  status               ReturnStatus @default(REQUESTED)
  notes                String?
  returnLabelUrl       String?
  returnLabelName      String?
  returnCourier        String?
  returnTrackingNumber String?
  returnTrackingUrl    String?
  refundProofUrl       String?
  refundProofName      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIAL
}

enum ReturnStatus {
  REQUESTED
  AWAITING_APPROVAL
  APPROVED
  COLLECTION_BOOKED
  IN_TRANSIT
  INSPECTING
  REFUND_APPROVED
  LABEL_SENT
  RECEIVED
  REFUNDED
  REJECTED
}

// ─── REQUESTS ──────────────────────────────────────────
model RepairRequest {
  id           String        @id @default(cuid())
  reference    String?       @unique
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  serviceType  String
  equipmentType String
  manufacturer String?
  model        String?
  faultDesc    String        @db.Text
  status       RequestStatus @default(NEW)
  assignedTo   String?
  notes        String?
  quotedPrice  Decimal?      @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AssetRecoveryRequest {
  id          String        @id @default(cuid())
  reference   String?       @unique
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  description String        @db.Text
  location    String?
  quantity    String?
  status      RequestStatus @default(NEW)
  notes       String?
  quotedValue Decimal?      @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContactRequest {
  id        String        @id @default(cuid())
  reference String?       @unique
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model QuoteRequest {
  id          String        @id @default(cuid())
  reference   String?       @unique
  name        String
  email       String
  phone       String?
  company     String?
  productUrl  String?
  productSku  String?
  productTitle String?
  variationSku String?
  variationLabel String?
  source      String?
  description String        @db.Text
  quantity    Int           @default(1)
  status      RequestStatus @default(NEW)
  notes       String?
  createdAt   DateTime      @default(now())
}

model SupportTicket {
  id        String        @id @default(cuid())
  reference String?       @unique
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  name      String
  email     String
  orderId   String?
  phone     String?
  country   String?
  company   String?
  productSku String?
  productTitle String?
  source    String?
  subject   String
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  adminNotes String?      @db.Text
  lastResponseAt DateTime?
  closedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  SupportMessage[]
}

model SupportMessage {
  id                String            @id @default(cuid())
  ticketId          String
  ticket            SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType        SupportAuthorType @default(ADMIN)
  authorName        String?
  authorEmail       String?
  message           String            @db.Text
  isCustomerVisible Boolean           @default(true)
  emailSent         Boolean           @default(false)
  createdAt         DateTime          @default(now())
}

enum SupportAuthorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}



model Lead {
  id           String   @id @default(cuid())
  name         String?
  email        String
  phone        String?
  country      String?
  company      String?
  source       String
  sourceRef    String?
  productSku   String?
  productTitle String?
  orderId      String?
  invoiceId    String?
  notes        String?   @db.Text
  contactCount Int      @default(1)
  lastContactAt DateTime @default(now())
  interactions LeadInteraction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([source])
  @@index([productSku])
  @@index([createdAt])
}

model LeadInteraction {
  id           String   @id @default(cuid())
  leadId       String
  source       String
  sourceRef    String?
  productSku   String?
  productTitle String?
  orderId      String?
  invoiceId    String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([source])
  @@index([createdAt])
}



// ─── EBAY SYNC ────────────────────────────────────────
model EbaySyncConfig {
  id           String   @id @default(cuid())
  environment  String   @default("production")
  marketplaceId String  @default("EBAY_GB")
  clientId     String?
  clientSecret String?
  ruName       String?
  refreshToken String?   @db.Text
  accessToken  String?   @db.Text
  accessTokenExpiresAt DateTime?
  lastSyncAt   DateTime?
  syncCursorPage Int     @default(1)
  syncTotalPages Int?
  syncLastMode   String?
  syncLastBatchSize Int  @default(50)
  syncLastStartedAt DateTime?
  syncLastCompletedAt DateTime?
  syncDone       Boolean @default(true)
  syncPaused     Boolean @default(false)
  syncLastMessage String? @db.Text
  syncLastError   String? @db.Text

  // Outbound publishing defaults
  defaultInventoryLocationKey String?
  defaultPaymentPolicyId String?
  defaultReturnPolicyId String?
  defaultFulfillmentPolicyId String?
  defaultListingDuration String? @default("GTC")
  defaultSkuPrefix String? @default("CBUK")
  autoGenerateSku Boolean @default(true)
  autoPublishToEbay Boolean @default(false)
  manualApprovalBeforePublish Boolean @default(true)
  defaultDescriptionTemplateId String?
  defaultConditionMappingJson Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model EbayAccountDeletionNotification {
  id             String   @id @default(cuid())
  notificationId String?  @unique
  topic          String?
  username       String?
  ebayUserId     String?
  eventDate      DateTime?
  publishDate    DateTime?
  payload        Json
  headers        Json?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  status         String   @default("RECEIVED")
  notes          String?  @db.Text

  @@index([topic])
  @@index([username])
  @@index([ebayUserId])
  @@index([receivedAt])
}



// ─── OPERATIONS, STOCK & ADMIN NOTIFICATIONS ─────────
model InventoryMovement {
  id                String   @id @default(cuid())
  productId         String?
  variantId         String?
  sku               String
  variationSku      String?
  type              String
  quantityChange    Int
  source            String
  sourceId          String
  externalReference String   @unique
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  createdBy         String?

  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@index([source, sourceId])
  @@index([createdAt])
}

model InventorySyncJob {
  id          String   @id @default(cuid())
  productId   String?
  variantId   String?
  sku         String
  target      String
  action      String
  status      String   @default("QUEUED")
  attempts    Int      @default(0)
  payload     Json?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@index([target, status])
  @@index([createdAt])
}

model AdminNotification {
  id            String   @id @default(cuid())
  type          String
  title         String
  message       String?  @db.Text
  sourceModel   String?
  sourceId      String?
  customerName  String?
  customerEmail String?
  amount        Decimal? @db.Decimal(10, 2)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  readAt        DateTime?

  @@index([type])
  @@index([isRead, createdAt])
  @@index([sourceModel, sourceId])
}

model SkuAuditLog {
  id               String   @id @default(cuid())
  productId         String?
  oldSku            String?
  newSku            String
  reason            String
  changedBy         String?
  changedAt         DateTime @default(now())
  ebayUpdateStatus  String?
  ebayUpdateError   String?  @db.Text

  @@index([productId])
  @@index([newSku])
  @@index([changedAt])
}

// ─── EBAY OUTBOUND PUBLISHING ─────────────────────────
model EbaySyncLog {
  id            String   @id @default(cuid())
  productId     String?
  sku           String?
  productTitle  String?
  actionType    String
  status        String   @default("PENDING")
  ebayListingId String?
  ebayOfferId   String?
  message       String?  @db.Text
  errorMessage  String?  @db.Text
  rawPayload    Json?
  retryCount    Int      @default(0)
  triggeredBy   String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([productId])
  @@index([sku])
  @@index([actionType])
  @@index([status])
  @@index([startedAt])
}

model EbayPolicyMapping {
  id            String   @id @default(cuid())
  type          String
  combayKey     String?
  ebayPolicyId  String
  ebayPolicyName String?
  marketplaceId String   @default("EBAY_GB")
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, marketplaceId])
  @@index([combayKey])
  @@index([isDefault])
}

model EbayCategoryMapping {
  id                 String   @id @default(cuid())
  combayCategorySlug String
  combayCategoryName String?
  ebayCategoryId     String
  ebayCategoryName   String?
  marketplaceId      String   @default("EBAY_GB")
  confidence         Decimal? @db.Decimal(5, 2)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([combayCategorySlug, marketplaceId])
  @@index([ebayCategoryId])
}

model EbayAspectMapping {
  id              String   @id @default(cuid())
  ebayCategoryId  String
  combaySpecLabel String
  ebayAspectName  String
  isRequired      Boolean  @default(false)
  marketplaceId   String   @default("EBAY_GB")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ebayCategoryId, combaySpecLabel, marketplaceId])
  @@index([ebayAspectName])
}

model EbayPublishJob {
  id            String   @id @default(cuid())
  productId     String
  sku           String?
  action        String
  status        String   @default("QUEUED")
  marketplaceId String   @default("EBAY_GB")
  payload       Json?
  errorMessage  String?  @db.Text
  attempts      Int      @default(0)
  queuedBy      String?
  queuedAt      DateTime @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([action])
  @@index([status])
  @@index([queuedAt])
}

model EbayListingRevision {
  id           String   @id @default(cuid())
  productId    String
  sku          String?
  action       String
  previousJson Json?
  nextJson     Json?
  reason       String?  @db.Text
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([sku])
  @@index([createdAt])
}

model EbayInventoryLocation {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  countryCode  String   @default("GB")
  postcode     String?
  addressLine1 String?
  city         String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model EbayDescriptionTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  html        String   @db.Text
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDefault])
  @@index([isSystem])
}

model EbaySyncRun {
  id          String   @id @default(cuid())
  status      String
  mode        String?
  startPage   Int?
  nextPage    Int?
  totalPages  Int?
  records     Int      @default(0)
  message     String?  @db.Text
  imported    Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  errors      String[]
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([mode])
  @@index([status])
  @@index([startedAt])
}

// ─── CONTENT ───────────────────────────────────────────
model Promotion {
  id            String    @id @default(cuid())
  name          String
  code          String?   @unique
  type          PromotionType
  value         Decimal   @db.Decimal(8, 2)
  description   String?
  isActive      Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  showOnHomepage Boolean  @default(false)
  showOnShop     Boolean  @default(false)
  bannerText     String?
  displayPriority Int     @default(100)
  productTargets PromotionProductTarget[]
  includeCategorySlugs String[] @default([])
  excludeCategorySlugs String[] @default([])
  includeBrands        String[] @default([])
  excludeBrands        String[] @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PromotionProductTarget {
  id          String   @id @default(cuid())
  promotionId String
  productId   String
  mode        String
  createdAt   DateTime @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([promotionId, productId, mode])
  @@index([promotionId])
  @@index([productId])
  @@index([mode])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model EmailAutomationRule {
  id          String   @id @default(cuid())
  name        String
  trigger     EmailAutomationTrigger
  isActive    Boolean  @default(true)
  subject     String
  body        String   @db.Text
  ctaLabel    String?
  ctaUrl      String?
  delayHours  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        EmailAutomationLog[]

  @@index([trigger])
  @@index([isActive])
}

model EmailDraftTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("general")
  trigger   EmailAutomationTrigger
  subject   String
  body      String   @db.Text
  ctaLabel  String?
  ctaUrl    String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([trigger])
}

model EmailAutomationLog {
  id             String   @id @default(cuid())
  ruleId         String?
  rule           EmailAutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  trigger        EmailAutomationTrigger
  recipientEmail String
  userId         String?
  orderId        String?
  subject        String?
  preview        String?  @db.Text
  category       String?
  status         String   @default("PENDING")
  message        String?  @db.Text
  providerId     String?
  sentAt         DateTime?
  skippedReason  String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([trigger])
  @@index([recipientEmail])
  @@index([orderId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum EmailAutomationTrigger {
  NEW_SIGNUP
  FIRST_ORDER_COMPLETED
  ORDER_COMPLETED
  MONTHLY_JANUARY
  MONTHLY_FEBRUARY
  MONTHLY_MARCH
  MONTHLY_APRIL
  MONTHLY_MAY
  MONTHLY_JUNE
  MONTHLY_JULY
  MONTHLY_AUGUST
  MONTHLY_SEPTEMBER
  MONTHLY_OCTOBER
  MONTHLY_NOVEMBER
  MONTHLY_DECEMBER
  NEW_YEAR
  SUMMER
  EASTER
  CHRISTMAS
  BOXING_DAY
}
